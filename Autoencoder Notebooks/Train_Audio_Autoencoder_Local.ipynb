    "{\n",
    "  \"cells\": [\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"# Train Audio Autoencoder (Local)\\n\",\n",
    "        \"\\n\",\n",
    "        \"Notebook wrapper for `train_autoencoder_audio_local.py` with compressor-oriented options.\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"from pathlib import Path\\n\",\n",
    "        \"import subprocess\\n\",\n",
    "        \"import shlex\\n\",\n",
    "        \"\\n\",\n",
    "        \"ROOT = Path('/Users/tyejaedon/PycharmProjects/AI_Compressor')\\n\",\n",
    "        \"PY = ROOT / '.venv/bin/python3'\\n\",\n",
    "        \"SCRIPT = ROOT / 'train_autoencoder_audio_local.py'\\n\",\n",
    "        \"\\n\",\n",
    "        \"DATA_DIR = ROOT / 'data/AudioData/ESC-50-master/audio'\\n\",\n",
    "        \"OUT = ROOT / 'models/notebook_audio'\\n\",\n",
    "        \"\\n\",\n",
    "        \"cmd = [\\n\",\n",
    "        \"    str(PY), str(SCRIPT),\\n\",\n",
    "        \"    '--preset', 'm1-air-balanced',\\n\",\n",
    "        \"    '--data-dir', str(DATA_DIR),\\n\",\n",
    "        \"    '--clip-seconds', '1.0',\\n\",\n",
    "        \"    '--sample-rate', '16000',\\n\",\n",
    "        \"    '--latent-dim', '128',\\n\",\n",
    "        \"    '--latent-l1', '1e-4',\\n\",\n",
    "        \"    '--latent-bits', '12',\\n\",\n",
    "        \"    '--epochs', '12',\\n\",\n",
    "        \"    '--target-psnr', '30',\\n\",\n",
    "        \"    '--output-root', str(OUT),\\n\",\n",
    "        \"]\\n\",\n",
    "        \"\\n\",\n",
    "        \"print('Running:')\\n\",\n",
    "        \"print(' '.join(shlex.quote(x) for x in cmd))\\n\",\n",
    "        \"subprocess.run(cmd, check=True)\"\n",
    "      ]\n",
    "    }\n",
    "  ],\n",
