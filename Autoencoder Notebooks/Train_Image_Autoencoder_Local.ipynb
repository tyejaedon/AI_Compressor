   "source": [
    "{\n",
    "  \"cells\": [\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"# Train Image Autoencoder (Local)\\n\",\n",
    "        \"\\n\",\n",
    "        \"Notebook wrapper for `train_autoencoder_image_local.py`.\\n\",\n",
    "        \"\\n\",\n",
    "        \"This runs the explicit train/val/test split flow to reduce data leakage.\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"from pathlib import Path\\n\",\n",
    "        \"import subprocess\\n\",\n",
    "        \"import shlex\\n\",\n",
    "        \"\\n\",\n",
    "        \"ROOT = Path('/Users/tyejaedon/PycharmProjects/AI_Compressor')\\n\",\n",
    "        \"PY = ROOT / '.venv/bin/python3'\\n\",\n",
    "        \"SCRIPT = ROOT / 'train_autoencoder_image_local.py'\\n\",\n",
    "        \"\\n\",\n",
    "        \"TRAIN_DIR = ROOT / 'data/cifar10 2/train'\\n\",\n",
    "        \"VAL_DIR = ROOT / 'data/cifar10 2/val'\\n\",\n",
    "        \"TEST_DIR = ROOT / 'data/cifar10 2/test'\\n\",\n",
    "        \"HOLDOUT_DIR = ROOT / 'data/ImageData'\\n\",\n",
    "        \"OUT = ROOT / 'models/notebook_image_upscaler'\\n\",\n",
    "        \"\\n\",\n",
    "        \"cmd = [\\n\",\n",
    "        \"    str(PY), str(SCRIPT),\\n\",\n",
    "        \"    '--preset', 'custom',\\n\",\n",
    "        \"    '--train-dir', str(TRAIN_DIR),\\n\",\n",
    "        \"    '--val-dir', str(VAL_DIR),\\n\",\n",
    "        \"    '--test-dir', str(TEST_DIR),\\n\",\n",
    "        \"    '--holdout-dir', str(HOLDOUT_DIR),\\n\",\n",
    "        \"    '--split-file-limit', '1000',\\n\",\n",
    "        \"    '--real-only',\\n\",\n",
    "        \"    '--disable-target-psnr-stop',\\n\",\n",
    "        \"    '--target-psnr', '50',\\n\",\n",
    "        \"    '--epochs', '10',\\n\",\n",
    "        \"    '--batch-size', '8',\\n\",\n",
    "        \"    '--block-size', '64',\\n\",\n",
    "        \"    '--latent-dim', '96',\\n\",\n",
    "        \"    '--train-patches-per-image', '1',\\n\",\n",
    "        \"    '--upscale-factor', '2',\\n\",\n",
    "        \"    '--degrade-interp', 'bicubic',\\n\",\n",
    "        \"    '--loss-profile', 'balanced',\\n\",\n",
    "        \"    '--lr', '5e-4',\\n\",\n",
    "        \"    '--grad-clipnorm', '1.0',\\n\",\n",
    "        \"    '--output-root', str(OUT),\\n\",\n",
    "        \"    '--no-export-tflite',\\n\",\n",
    "        \"]\\n\",\n",
    "        \"\\n\",\n",
    "        \"print('Running:')\\n\",\n",
    "        \"print(' '.join(shlex.quote(x) for x in cmd))\\n\",\n",
    "        \"subprocess.run(cmd, check=True)\"\n",
    "      ]\n",
    "    }\n",
    "  ],\n",
    "  \"metadata\": {\n",
    "    \"kernelspec\": {\n",
    "      \"display_name\": \"Python 3\",\n",
    "      \"language\": \"python\",\n",
    "      \"name\": \"python3\"\n",
    "    },\n",
