   "source": [
    "{\n",
    "  \"cells\": [\n",
    "    {\n",
    "      \"cell_type\": \"markdown\",\n",
    "      \"metadata\": {},\n",
    "      \"source\": [\n",
    "        \"# Train Image Lossy Autoencoder (Local)\\n\",\n",
    "        \"\\n\",\n",
    "        \"Notebook wrapper for `train_autoencoder_image_lossy_local.py`.\\n\",\n",
    "        \"\\n\",\n",
    "        \"Uses real data and balanced quality/compression defaults.\"\n",
    "      ]\n",
    "    },\n",
    "    {\n",
    "      \"cell_type\": \"code\",\n",
    "      \"execution_count\": null,\n",
    "      \"metadata\": {},\n",
    "      \"outputs\": [],\n",
    "      \"source\": [\n",
    "        \"from pathlib import Path\\n\",\n",
    "        \"import subprocess\\n\",\n",
    "        \"import shlex\\n\",\n",
    "        \"\\n\",\n",
    "        \"ROOT = Path('/Users/tyejaedon/PycharmProjects/AI_Compressor')\\n\",\n",
    "        \"PY = ROOT / '.venv/bin/python3'\\n\",\n",
    "        \"SCRIPT = ROOT / 'train_autoencoder_image_lossy_local.py'\\n\",\n",
    "        \"\\n\",\n",
    "        \"DATA_DIR = ROOT / 'data/cifar10 2/train'\\n\",\n",
    "        \"OUT = ROOT / 'models/notebook_image_lossy'\\n\",\n",
    "        \"\\n\",\n",
    "        \"cmd = [\\n\",\n",
    "        \"    str(PY), str(SCRIPT),\\n\",\n",
    "        \"    '--preset', 'custom',\\n\",\n",
    "        \"    '--data-dir', str(DATA_DIR),\\n\",\n",
    "        \"    '--real-only',\\n\",\n",
    "        \"    '--min-real-images', '300',\\n\",\n",
    "        \"    '--min-split-images', '20',\\n\",\n",
    "        \"    '--real-file-limit', '2500',\\n\",\n",
    "        \"    '--block-size', '64',\\n\",\n",
    "        \"    '--latent-dim', '128',\\n\",\n",
    "        \"    '--latent-l1', '1e-4',\\n\",\n",
    "        \"    '--latent-bits', '12',\\n\",\n",
    "        \"    '--batch-size', '16',\\n\",\n",
    "        \"    '--epochs', '12',\\n\",\n",
    "        \"    '--lr', '5e-4',\\n\",\n",
    "        \"    '--rate-lambda', '0.002',\\n\",\n",
    "        \"    '--sample-count', '32',\\n\",\n",
    "        \"    '--jpeg-quality', '90',\\n\",\n",
    "        \"    '--target-psnr', '24',\\n\",\n",
    "        \"    '--output-root', str(OUT),\\n\",\n",
    "        \"    '--no-export-tflite',\\n\",\n",
    "        \"]\\n\",\n",
    "        \"\\n\",\n",
    "        \"print('Running:')\\n\",\n",
    "        \"print(' '.join(shlex.quote(x) for x in cmd))\\n\",\n",
    "        \"subprocess.run(cmd, check=True)\"\n",
    "      ]\n",
    "    }\n",
    "  ],\n",
    "  \"metadata\": {\n",
    "    \"kernelspec\": {\n",
    "      \"display_name\": \"Python 3\",\n",
